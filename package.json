{
  "name": "@webship.co/workspace-bootstrap",
  "version": "1.0.0",
  "description": "Bootstrap for Webship Workspace: the builder (`cmd-bootstrap-project.sh`) in every sites folder, which serves the components demo site of the Bootstrap step pack in a container (version 5.3, or 4.6), the step pack wired into the testing setup of such a site, and its AI items in their folders: two agents, a skill, a command and two prompts for testing and building Bootstrap UIs.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-bootstrap.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "bootstrap",
    "label": "Bootstrap",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-bootstrap-project.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-bootstrap.sh"
      ],
      "args": [
        "scripts/args/arg-bootstrap.sh"
      ],
      "machine": [
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/bootstrap-ui-builder.md",
        "ai/agents/bootstrap-tester.md"
      ],
      "skills": [
        "ai/skills/bootstrap-scenarios"
      ],
      "commands": [
        "ai/commands/bootstrap-test.md"
      ],
      "prompts": [
        "ai/prompts/bootstrap-build-and-test.md",
        "ai/prompts/bootstrap-scenarios-for-a-site.md"
      ]
    },
    "features": [
      "features/bootstrap.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
